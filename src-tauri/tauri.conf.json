{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha2026",
  "version": "0.1.0",
  "identifier": "com.gurin.alpha2026",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/alpha2026/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Alpha2026",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": [
      "dictionary.db"
    ]
  }
}

# Автоматически нормализовать окончания строк
* text=auto

# Исходный код — LF
*.ts    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Windows-скрипты — CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Бинарные файлы — не трогать
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
*.db    binary
*.zip   binary
